# 6block 환경 변수 예시. 실제 값은 .env에 넣으세요(.env는 git에 올라가지 않습니다).
# 구글 캘린더 > 설정 및 공유 > 캘린더 통합 > "iCal 형식의 비공개 주소"(.ics)
# GCAL_ICAL_URL = 계획 캘린더(노란색), GCAL_ICAL_URL_2 = 모임/여행 캘린더(빨간색)
GCAL_ICAL_URL=
GCAL_ICAL_URL_2=

# 고결감(고민·결정·감사) → 구글 캘린더 '고결감' 양방향(서비스계정 방식). 비우면 고결감 탭은 로컬 저장만.
# 1) 구글 클라우드 콘솔에서 프로젝트 생성 → Google Calendar API 사용 설정
# 2) 서비스계정 생성 → JSON 키 발급 → secrets/gcal-sa.json 으로 저장(.gitignore에 이미 제외됨)
# 3) '고결감' 캘린더 설정 > 특정 사용자와 공유에 서비스계정 이메일 추가(변경 권한)
# 4) GCAL_WRITE_CALENDAR_ID = 그 캘린더 ID(...@group.calendar.google.com)
GCAL_WRITE_CALENDAR_ID=
GCAL_SA_KEYFILE=secrets/gcal-sa.json

# 오늘 탭에서 만든 '일정'을 쓸 구글 캘린더(보통 계획 캘린더). 비우면 일정 쓰기만 비활성(읽기·할일은 정상).
# 그 캘린더 설정 > 특정 사용자와 공유에 위 서비스계정 이메일을 '변경 권한'으로 추가한 뒤
# GCAL_WRITE_EVENTS_CALENDAR_ID = 그 캘린더 ID(보통 본인 gmail 주소 또는 ...@group.calendar.google.com)
GCAL_WRITE_EVENTS_CALENDAR_ID=

# 오늘 '달성' 3줄을 종일 이벤트(설명란 1. 2. 3.)로 쓸 '성과' 캘린더. 비우면 성과 쓰기만 비활성.
# 그 캘린더 설정 > 특정 사용자와 공유에 위 서비스계정 이메일을 '변경 권한'으로 추가한 뒤
# GCAL_WRITE_ACHIEVE_CALENDAR_ID = 그 캘린더 ID(...@group.calendar.google.com)
GCAL_WRITE_ACHIEVE_CALENDAR_ID=

# 선택적 AI 연결(자동 세분화·개선점 문장). OpenAI 호환 chat/completions면 무엇이든 가능.
# 셋 다 채우면 켜지고, 비우면 규칙기반으로만 동작한다. base URL·모델은 설정 탭에서도 바꿀 수 있다.
# 예: DeepSeek → AI_BASE_URL=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat
# 예: Gemini(OpenAI 호환) → AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
